{
  "name": "skillgate",
  "version": "0.0.0",
  "description": "Local runtime for selecting, controlling, and inspecting agent skills",
  "type": "module",
  "bin": {
    "skillgate": "./dist/cli.js",
    "skillgate-mcp": "./dist/mcp/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/validate-cli-json-fixtures.mjs && vitest run",
    "test:protocol": "node scripts/validate-cli-json-fixtures.mjs",
    "test:adapters": "vitest run src/adapters",
    "benchmark": "vitest run src/benchmark",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "prepack": "npm run check && npm run build",
    "inspect:pack": "npm pack --dry-run",
    "smoke:mcp": "node scripts/smoke-mcp.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fajarbc/skillgate.git"
  },
  "bugs": {
    "url": "https://github.com/fajarbc/skillgate/issues"
  },
  "homepage": "https://github.com/fajarbc/skillgate#readme",
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
